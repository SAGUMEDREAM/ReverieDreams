translationBuilder.add(ItemDescriptionConsts.SEA_URCHIN_SASHIMI_DESCRIPTION_1, "但获取食材却非常困难");
translationBuilder.add(ItemDescriptionConsts.SEA_URCHIN_SASHIMI_DESCRIPTION_2, "据说是现世流行的超高级料理");
