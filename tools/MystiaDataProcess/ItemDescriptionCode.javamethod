translationBuilder.add(ItemDescriptionConsts.TAKOYAKI_DESCRIPTION_1, "在特制的面糊中裹上引发奇迹的章鱼脚");
translationBuilder.add(ItemDescriptionConsts.TAKOYAKI_DESCRIPTION_2, "糯脆的外衣之下Q弹的章鱼脚产生让人幸福的感觉");
