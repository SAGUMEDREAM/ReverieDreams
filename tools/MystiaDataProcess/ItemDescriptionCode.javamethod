translationBuilder.add(ItemDescriptionConsts.ALL_MEAT_FEAST_DESCRIPTION_1, "无论视觉还是分量上都简单暴力");
translationBuilder.add(ItemDescriptionConsts.ALL_MEAT_FEAST_DESCRIPTION_2, "对于嗅觉灵敏的食客是秒杀级的食谱");
