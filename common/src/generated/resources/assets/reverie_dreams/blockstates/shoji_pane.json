{
  "multipart": [
    {
      "apply": {
        "model": "reverie_dreams:block/shoji_pane_panel_x"
      },
      "when": {
        "north": "true",
        "south": "true"
      }
    },
    {
      "apply": {
        "model": "reverie_dreams:block/shoji_pane_half"
      },
      "when": {
        "north": "true",
        "south": "false"
      }
    },
    {
      "apply": {
        "model": "reverie_dreams:block/shoji_pane_half",
